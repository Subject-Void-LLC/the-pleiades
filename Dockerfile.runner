FROM golang:1.26-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# Built as a PACKAGE path, not a single file. A single-file build
# silently stops compiling the moment the composition root is split
# across more than one file, while `make ci` (go build ./...) stays
# green, so the image breaks and nothing else does.
RUN go build -o runner ./cmd/runner

FROM alpine:3.24.1
WORKDIR /app
COPY --from=builder /app/runner .
# The runner resolves RUNBOOK_DIR the same way the controller does, and
# production shares one runbook directory between them, so the image needs
# the same path to exist.
RUN mkdir -p /app/runbooks
CMD ["./runner"]
