package render

import (
	"github.com/Subject-Void-LLC/the-pleiades/internal/ui/static"
	"github.com/Subject-Void-LLC/the-pleiades/internal/ui/view"
)

// Layout is every page's chrome.
//
// The document is assembled server-side including the theme, which is why
// there is no inline bootstrap script anywhere below: data-theme is
// already correct in the first byte the browser reads, so there is no
// flash to suppress and nothing for the content security policy to have
// to permit.
templ Layout(page view.PageModel) {
	<!DOCTYPE html>
	<html lang="en" data-skin={ page.Skin } data-theme={ page.Theme } data-a11y={ page.AccessibleMode() }>
		<head>
			<meta charset="utf-8"/>
			// No user-scalable=no and no maximum-scale: pinch zoom is how
			// a low-vision user reads a page, and taking it away is a
			// WCAG failure, not a layout preference.
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ page.DocumentTitle() }</title>
			<link rel="stylesheet" href={ page.AssetPath(static.Path("app.css")) }/>
			// Ported from the deleted SPA rather than redrawn. It is
			// content-hashed like every other asset, so a browser caches it
			// forever and a change to it is a different URL.
			<link rel="icon" type="image/svg+xml" href={ page.AssetPath(static.Path("favicon.svg")) }/>
			<script src={ page.AssetPath(static.Path("vendor/htmx.min.js")) } defer></script>
			<script src={ page.AssetPath(static.Path("app.js")) } defer></script>
			if page.Chart != nil {
				<script src={ page.AssetPath(static.Path("vendor/echarts.min.js")) } defer></script>
				<script src={ page.AssetPath(static.Path("chart.js")) } defer></script>
			}
			if page.Stream != nil {
				<script src={ page.AssetPath(static.Path("stream.js")) } defer></script>
			}
		</head>
		// One hx-headers on body carries the CSRF token on every HTMX
		// request in the application, so no author ever writes CSRF
		// handling into a template.
		<body hx-headers={ page.CSRFHeaders() }>
			// The skip link is the first focusable element on the page.
			// Without it a keyboard user tabs the entire sidebar before
			// reaching content, on every single navigation.
			if page.Banner.Configured() {
				// Top and bottom, per the classification standard: a
				// marking that scrolls out of view is not on the part of
				// the screen being read or photographed. It is first in
				// the DOM so a screen reader reaches it before anything
				// else, which is the same reason it is first visually.
				<div class={ "env-banner", "env-banner-top", page.Banner.Class() }>{ page.Banner.Label() }</div>
			}
			if !page.SignedIn() {
				// First in the document, and therefore the first thing a
				// keyboard or screen reader user reaches, on every page
				// reached without a session.
				//
				// It is ahead of the skip link deliberately. A skip link
				// exists to get past navigation, and a signed-out page has
				// none to get past; accessibility mode exists for somebody
				// who cannot comfortably read what is in front of them,
				// and on the sign-in page that is the only thing in front
				// of them. Making them tab through a form they are
				// struggling to read in order to reach the control that
				// makes it readable is the wrong way round.
				@accessibilityToggle(page, "a11y-bar")
			}
			<a class="skip-link" href="#main">Skip to main content</a>
			// The live region exists empty on every page. A region
			// inserted together with its text is never announced: the
			// screen reader has nothing to observe changing.
			<div id="live-announcer" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true"></div>
			<div class="layout">
				@sidebar(page)
				<main id="main" class="main" tabindex="-1">
					{ children... }
				</main>
			</div>
			if page.Banner.Configured() {
				<div class={ "env-banner", "env-banner-bottom", page.Banner.Class() }>{ page.Banner.Label() }</div>
			}
		</body>
	</html>
}

// sidebar renders identity, navigation and the theme control.
templ sidebar(page view.PageModel) {
	<aside class="sidebar">
		<div class="sidebar-brand">Pleiades</div>
		<div class="sidebar-version">{ page.Version }</div>
		// A native disclosure rather than a scripted menu. Below the
		// breakpoint the summary is the mobile menu button, drawn as a
		// hamburger in CSS; above it, the summary is hidden and the
		// navigation is held open. Either way the browser owns the
		// expanded state, the keyboard behaviour and the announcement,
		// which a hand-built button would need aria-expanded and script
		// to reproduce -- and the CSP carries no 'unsafe-inline'.
		//
		// The word "Navigation" is the control's accessible name and has
		// to stay: the hamburger is a background, so a summary holding
		// only the icon would announce as an unnamed toggle.
		<details class="nav-disclosure" open>
			<summary>Navigation</summary>
			// One landmark, not one per group. Every landmark needs a
			// unique accessible name, and five of them would turn a
			// screen reader's landmark list from one entry into five.
			// The groups are headings inside it instead, which also
			// gives heading navigation into the sidebar.
			<nav aria-label="Main">
				for _, section := range page.Nav {
					if section.Heading() {
						<h2 class="nav-group" id={ section.ID }>{ section.Label }</h2>
						<ul class="nav-list" aria-labelledby={ section.ID }>
							@navItems(section)
						</ul>
					} else {
						<ul class="nav-list">
							@navItems(section)
						</ul>
					}
				}
				// The deployment's own settings. Outside the group loop
				// because it is a fixed route rather than a registered
				// view, and last because that is where every comparable
				// control plane puts it: it is the entry an operator uses
				// least often and an administrator uses on the first day.
				if page.ShowSettings {
					<h2 class="nav-group" id="nav-group-settings">SETTINGS</h2>
					<ul class="nav-list" aria-labelledby="nav-group-settings">
						<li>
							if page.SettingsCurrent() {
								<a href={ templ.SafeURL(page.SettingsHref()) } aria-current="page">SETTINGS</a>
							} else {
								<a href={ templ.SafeURL(page.SettingsHref()) }>SETTINGS</a>
							}
						</li>
					</ul>
				}
			</nav>
		</details>
		if page.SignedIn() {
			@sessionControls(page)
			@accessibilityToggle(page, "a11y-toggle")
		}
	</aside>
}

// sessionControls name who is signed in and offer the way out.
//
// The sign-out control is a POST rather than a link. Sign-out deletes the
// session row, and anything reachable by GET is eventually reached by a link
// prefetcher, a corporate scanner or somebody's accelerator extension, all of
// which would sign the user out of a page they were reading. Going through a
// form also means sign-out carries the CSRF token like every other write in
// the application, rather than being the one state change that does not.
templ sessionControls(page view.PageModel) {
	if page.SignedIn() {
		<div class="session">
			<p class="session-subject">
				<span class="session-label">Signed in as</span>
				<span class="session-name">{ page.Subject }</span>
			</p>
			<p class="session-links">
				<a href={ templ.SafeURL(page.AccountHref()) }>Preferences</a>
				<form method="post" action={ page.LogoutAction() }>
					<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
					<button class="linkish" type="submit">Sign out</button>
				</form>
			</p>
		</div>
	}
}

// accessibilityToggle is the one appearance control that stays in the
// sidebar.
//
// Skin and theme moved to the settings page, because they are set once and
// then cost 250 pixels of every sidebar forever. This one did not, and the
// reason is not symmetry: accessibility mode is what somebody reaches for
// when the page in front of them has become hard to read, and a control you
// have to navigate away to find is a control you reach for by first coping
// with the thing you could not read. One click, on every page, always in the
// same place.
//
// It is a form, not a scripted switch. It works with scripting disabled, it
// carries the CSRF token like every other write, and the browser owns the
// button semantics. aria-pressed is what makes it a toggle rather than a
// button that does something once.
//
// One component, two placements, because a mode that works only once you are
// signed in is a mode that failed the person it exists for: the sign-in page
// is a page, and somebody who cannot read it cannot get past it to reach the
// control that would fix it. The placement class is the only difference; the
// route, the token and the semantics are identical, and /a11y is deliberately
// outside the session gate so both actually work. See web/preferences.go.
templ accessibilityToggle(page view.PageModel, placement string) {
	<form class={ placement } method="post" action={ page.A11yAction() }>
		<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
		// Where to put the reader back. Without it a preference change
		// returns them to whatever the Referer said, or to the index when a
		// browser sent none, which is a control that loses your place.
		<input type="hidden" name="_return" value={ page.ReturnTo }/>
		<button type="submit" name="a11y" value={ page.A11yNext() } aria-pressed={ page.A11yPressed() }>
			// Decorative: the button's own text is its accessible name,
			// and announcing "half-filled circle" before it would add a
			// word that means nothing to somebody who cannot see it.
			<svg class="a11y-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
				<circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
				<path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor"></path>
			</svg>
			<span class="a11y-label">Accessibility mode</span>
			<span class="a11y-state" aria-hidden="true">{ page.A11yStateLabel() }</span>
		</button>
	</form>
}

// navItems renders one group's entries. Its own component so the labelled
// and unlabelled lists cannot drift apart.
templ navItems(section view.NavSection) {
	for _, item := range section.Items {
		<li>
			if item.Current {
				<a href={ item.Href } aria-current="page">{ item.Label }</a>
			} else {
				<a href={ item.Href }>{ item.Label }</a>
			}
		</li>
	}
}
