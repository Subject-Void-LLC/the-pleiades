package render

import "github.com/Subject-Void-LLC/the-pleiades/internal/ui/view"

// List renders one resource's collection.
//
// Nothing here is per-resource. The columns, their headers, the mobile
// card labels and the cell formatting all come from the same Field
// declaration the descriptor already carries, which is why adding a
// resource adds no template.
templ List(m view.ListModel) {
	@Layout(m.Page) {
		@pageChrome(m.Chrome())
		if m.Aff.Unknown {
			@zeroState(view.AffordanceUnknown())
		}
		if m.HasChart() {
			@chart(m)
		}
		// A view need not list anything. The dashboard is a chart and
		// its operator notices, which is a finished shape rather than an
		// unfinished one, so the page renders whichever of its sections
		// exist instead of assuming a table is always the point.
		if m.Descriptor.ListsRecords() {
			@listRegion(m)
		}
		for _, section := range m.SectionViews() {
			@sectionPanel(section)
		}
	}
}

// listRegion is the swappable table.
//
// It is its own component because two callers render it: the whole page, and
// the fragment a refresh requests. One definition means a live update cannot
// produce different markup from the first paint, which is the failure that
// makes fragment swaps feel broken.
//
// hx-swap is outerHTML, so the replacement carries its own trigger. That is
// the whole stop mechanism: a region rendered without a trigger stops asking,
// and nothing has to cancel a timer.
templ listRegion(m view.ListModel) {
	<div
		class="list-region"
		id="resource-list"
		data-focus-after-swap="true"
		data-announce={ m.ResultCount() }
		if m.Polls() {
			hx-get={ m.RefreshHref() }
			hx-trigger={ m.RefreshTrigger() }
			hx-swap="outerHTML"
			data-poll="true"
		}
	>
		@dataTable(m.Table())
		// Inside the region rather than after it. The cursor is computed
		// from the rows this render produced, so a link left outside would
		// keep pointing past rows a refresh had already replaced.
		if m.NextHref() != "" {
			<nav class="pager" aria-label="Pagination">
				<a class="btn" href={ templ.SafeURL(m.NextHref()) }>Next page</a>
			</nav>
		}
	</div>
}

// ListFragment is the list's live region alone, with no page chrome.
//
// Returned when the request carries HTMX's own header, from the very URL the
// page came from. There is no second route and no second handler: the same
// read answers both, and a resource that declares a refresh writes no
// routing of any kind.
templ ListFragment(m view.ListModel) {
	@listRegion(m)
}

// chart renders the graphic and its text equivalent together.
//
// The table is not a fallback that appears when something fails -- it is
// always present, always populated server-side, and is the authoritative
// rendering. That is the only honest way to give a chart a text
// alternative: a 200-character alt attribute cannot carry a dataset, and a
// table that only materialises when a script fails is a table nobody has
// ever tested.
//
// The canvas carries no inline style and no inline script. It advertises
// its data URL in a data attribute and chart.js finds it, because the
// content security policy this UI ships under has no 'unsafe-inline' and
// the usual bootstrap for a charting library is exactly that.
templ chart(m view.ListModel) {
	<section class="chart-section" aria-labelledby="chart-heading">
		<h2 id="chart-heading">{ m.ChartTitle() }</h2>
		<p class="chart-caption" id="chart-caption">{ m.ChartCaption() }</p>
		<div class="chart-layout">
			// aria-hidden because everything this canvas conveys is in the
			// table beside it. Announcing an unlabelled graphic and then the
			// same numbers again wastes a screen reader user's time.
			<div
				class="chart-canvas"
				data-chart-url={ m.ChartDataHref() }
				aria-hidden="true"
			></div>
			<table class="table chart-table">
				<caption class="visually-hidden">{ m.ChartCaption() }</caption>
				<thead>
					<tr>
						<th scope="col">Status</th>
						<th scope="col">Count</th>
					</tr>
				</thead>
				<tbody>
					for _, b := range m.Chart.Buckets {
						<tr>
							<th scope="row" data-label="Status">
								<span class={ "badge", m.ChartBucketClass(b) }>{ b.Label }</span>
							</th>
							<td data-label="Count">{ m.ChartCount(b) }</td>
						</tr>
					}
				</tbody>
				<tfoot>
					<tr>
						<th scope="row">Total</th>
						<td>{ m.ChartTotal() }</td>
					</tr>
				</tfoot>
			</table>
		</div>
	</section>
}

// Stream is the live log page.
//
// Designed for a narrow screen first rather than adapted to one: watching a
// running job is the thing somebody is most likely to open away from a
// desk, and usually because something has already gone wrong.
templ Stream(m view.StreamModel) {
	@Layout(m.Page) {
		@pageChrome(m.Chrome())
		@streamRegion(m.StreamURL())
	}
}

// streamRegion is the live log itself, with its controls.
//
// Its own component because two pages render it: this standalone one, kept
// for links made before the record had a tab for it, and the record's own
// Output tab. One definition means watching a job from its record and
// watching it from a bookmark cannot behave differently.
templ streamRegion(url string) {
	<div class="stream-controls">
		<div class="field">
			<label for="log-filter">Filter</label>
			<input type="search" id="log-filter" data-log-filter="true" autocomplete="off"/>
		</div>
		<div class="field field-inline">
			<input type="checkbox" id="log-follow" data-log-follow="true" checked/>
			<label for="log-follow">Follow new lines</label>
		</div>
	</div>
	// A status region, not an alert: connection state changes are worth
	// announcing but must not interrupt what is being read.
	<p class="stream-status" id="log-status" role="status" aria-live="polite">Connecting…</p>
	// The log is a log element with its own live region. Lines wrap
	// rather than scrolling sideways, so a phone never asks its reader
	// to pan horizontally to finish a sentence.
	<div
		class="stream-log"
		id="log-output"
		role="log"
		aria-live="polite"
		aria-label="Live output"
		tabindex="0"
		data-stream-url={ url }
	></div>
}

// Detail renders one record.
templ Detail(m view.DetailModel) {
	@Layout(m.Page) {
		@pageChrome(m.Chrome())
		if m.Aff.Unknown {
			@zeroState(view.AffordanceUnknown())
		}
		@detailRegion(m)
		if m.CanDelete() {
			@confirmDelete(m)
		}
	}
}

// detailRegion is a record's live content: whichever of its parts the
// selected tab names.
//
// The action bar is deliberately outside it, on the chrome. Those controls
// are computed from the caller's permitted set, and re-rendering them every
// few seconds would move a Delete button under a cursor already travelling
// toward it. What changes on its own is data, not what a person may do.
templ detailRegion(m view.DetailModel) {
	<div
		class="record-region"
		id="record-detail"
		data-announce={ m.RefreshAnnouncement() }
		if m.Polls() {
			hx-get={ m.RefreshHref() }
			hx-trigger={ m.RefreshTrigger() }
			hx-swap="outerHTML"
			data-poll="true"
		}
	>
		if m.ShowDetails() {
			<div class="block">
				<dl class="detail-list">
					for _, f := range m.Fields() {
						<dt>{ f.Label }</dt>
						<dd>@detailValue(m, f)</dd>
					}
				</dl>
			</div>
		} else if m.ShowStream() {
			@streamRegion(m.StreamURL())
		}
		for _, section := range m.SectionViews() {
			@sectionPanel(section)
		}
	</div>
}

// detailValue renders one of a record's own values.
//
// The same three cases a table cell has, for the same reason: a state should
// read as a badge wherever it appears, and a field that names another record
// should reach it from the record page too. Without this the detail list was
// the one place in the application where a reference was plain text, so the
// walk down a hierarchy stopped at the first record you opened.
templ detailValue(m view.DetailModel, f view.Field) {
	if f.RendersBadge() {
		<span class={ "badge", m.BadgeClass(f) }>{ m.Value(f) }</span>
	} else if href := m.RefHref(f); href != "" {
		<a href={ templ.SafeURL(href) }>{ m.Value(f) }</a>
	} else {
		{ m.Value(f) }
	}
}

// DetailFragment is a record's live region alone, answered from the record's
// own URL when the request carries HTMX's header.
templ DetailFragment(m view.DetailModel) {
	@detailRegion(m)
}

// confirmDelete is a native dialog, which brings the focus trap, the
// Escape handler and the inert background with it. app.js adds only the
// one thing showModal does not do: returning focus to the trigger.
templ confirmDelete(m view.DetailModel) {
	<dialog id="confirm-delete" aria-labelledby="confirm-delete-heading">
		<div class="block">
			<h2 id="confirm-delete-heading">Delete { m.Row.ID }?</h2>
			<p>This retires the record. It cannot be undone from here.</p>
			<form method="post" action={ templ.SafeURL(m.SelfHref()) }>
				<input type="hidden" name="_csrf" value={ m.Page.CSRFToken }/>
				<input type="hidden" name="_method" value="DELETE"/>
				<button class="btn btn-danger" type="submit">Delete</button>
				<button class="btn" type="button" data-dialog-close="true">Cancel</button>
			</form>
		</div>
	</dialog>
}

// Form renders a create or edit form.
templ Form(m view.FormModel) {
	@Layout(m.Page) {
		@pageChrome(m.Chrome())
		<form method="post" action={ templ.SafeURL(m.Action()) }>
			<input type="hidden" name="_csrf" value={ m.Page.CSRFToken }/>
			if m.HasErrors() {
				// The summary is focused on a failed submission, so a
				// screen reader user is taken to what went wrong instead
				// of being left wherever they submitted from.
				<div class="error-summary" id="error-summary" role="alert" tabindex="-1">
					<h2>This form could not be saved</h2>
					<ul>
						for _, e := range m.Summary() {
							<li><a href={ templ.SafeURL("#f-" + e.Field) }>{ e.Label }: { e.Message }</a></li>
						}
					</ul>
				</div>
			}
			for _, f := range m.Fields() {
				@field(m, f)
			}
			<div class="form-actions">
				<button class="btn" type="submit">Save</button>
				<a class="btn" href={ templ.SafeURL(m.CancelHref()) }>Cancel</a>
			</div>
		</form>
	}
}

// Action renders a record action's prompt form.
//
// It reuses the same field component the create and edit forms use, driven
// by ActionModel.Form(). A second form template would be a second copy of
// the labels, hints, error summary and focus handling to keep accessible,
// and the one that drifts is always the one with fewer readers.
templ Action(m view.ActionModel) {
	@Layout(m.Page) {
		@pageChrome(m.Chrome())
		<form method="post" action={ templ.SafeURL(m.ActionHref()) }>
			<input type="hidden" name="_csrf" value={ m.Page.CSRFToken }/>
			if m.Form().HasErrors() {
				<div class="error-summary" id="error-summary" role="alert" tabindex="-1">
					<h2>This action could not be started</h2>
					<ul>
						for _, e := range m.Form().Summary() {
							<li><a href={ templ.SafeURL("#f-" + e.Field) }>{ e.Label }: { e.Message }</a></li>
						}
					</ul>
				</div>
			}
			for _, f := range m.Form().Fields() {
				@field(m.Form(), f)
			}
			<div class="form-actions">
				<button class="btn" type="submit">{ m.SubmitLabel() }</button>
				<a class="btn" href={ templ.SafeURL(m.CancelHref()) }>Cancel</a>
			</div>
		</form>
	}
}

// Declared is what a StatusDeclared view renders. It says out loud that it
// is a skeleton rather than presenting an empty page that looks broken.
templ Declared(m view.DeclaredModel) {
	@Layout(m.Page) {
		@pageChrome(m.Chrome())
		// The columns this view will list, with the not-implemented panel
		// inside them. A declared view that says only "this is missing"
		// is a view nobody can review; one that shows its shape is one
		// somebody can say is the wrong shape before it is built.
		@dataTable(m.Table())
		if m.HasFutureTabs() {
			<section class="detail-section" aria-labelledby="future-tabs-heading">
				<h2 id="future-tabs-heading">Record tabs</h2>
				<p class="view-summary">What a single record will carry once this view has a port behind it.</p>
				<ul class="future-tabs">
					for _, tab := range m.FutureTabs() {
						<li>{ tab.Label }</li>
					}
				</ul>
			</section>
		}
	}
}

// Login exchanges a credential for a session cookie.
//
// Two forms rather than one with both credential kinds in it. A single form
// would submit whichever fields happened to be filled, which makes "which
// credential am I using" a property of what the browser autofilled rather
// than of what the operator chose, and it would put a required attribute on
// fields that must not be required.
templ Login(m view.PageModel, failed bool) {
	@Layout(m) {
		<header class="view-header">
			<h1>Sign in</h1>
		</header>
		if failed {
			// One message for both credential kinds and every reason. Saying
			// which field was wrong, or that an account exists, is the
			// account-existence oracle the whole sign-in path is built to
			// avoid.
			<div class="error-summary" role="alert" tabindex="-1">
				<p>Those credentials were not accepted.</p>
			</div>
		}
		if m.PasswordLogin {
			<form class="block" method="post" action={ templ.SafeURL(m.Prefix + "/login") }>
				<input type="hidden" name="_csrf" value={ m.CSRFToken }/>
				<div class="field">
					<label for="email">Email</label>
					<input type="email" id="email" name="email" autocomplete="username" required/>
				</div>
				<div class="field">
					<label for="password">Password</label>
					<input type="password" id="password" name="password" autocomplete="current-password" required/>
				</div>
				<div class="form-actions">
					<button class="btn" type="submit">Sign in</button>
				</div>
			</form>
		}
		<form class="block" method="post" action={ templ.SafeURL(m.Prefix + "/login") }>
			<input type="hidden" name="_csrf" value={ m.CSRFToken }/>
			<div class="field">
				<label for="token">API token</label>
				<p class="field-hint" id="token-hint">
					if m.PasswordLogin {
						The break-glass route, for an operator holding a token
						from an external issuer. It is exchanged for a session
						cookie, and is not stored.
					} else {
						Paste a token this control plane will accept. It is
						exchanged for a session cookie, and is not stored.
					}
				</p>
				// type=password so it is not shoulder-surfed, but paste is
				// never blocked: blocking paste on a 900-character token is
				// hostile and is itself an accessibility failure.
				<input type="password" id="token" name="token" autocomplete="off" aria-describedby="token-hint" required/>
			</div>
			<div class="form-actions">
				<button class="btn" type="submit">Sign in</button>
			</div>
		</form>
	}
}

// Settings is the signed-in caller's own preferences.
//
// It takes no record id, and every form on it posts to a route that takes
// none either. That is the authorization: the session is the subject, so
// there is no field anybody could put another account's address into.
templ Account(m view.AccountModel) {
	@Layout(m.Page) {
		@pageChrome(m.Chrome())
		if m.Page.Notice != "" {
			<div class="error-summary" role="alert" tabindex="-1">
				<p>{ m.Page.Notice }</p>
			</div>
		}
		if m.ShowAppearance() {
			@appearanceSection(m)
		} else if m.ShowPassword() {
			@passwordSection(m)
		}
	}
}

// appearanceSection is the three appearance axes, each its own form.
//
// All three post real forms, so every one works with scripting disabled and
// none needs client-side persistence. Each is its own fieldset with its own
// legend, so a screen reader user hears what a group of controls is for
// before hearing the controls.
templ appearanceSection(m view.AccountModel) {
	<section class="block settings-block">
		<form method="post" action={ m.Page.SkinAction() }>
			<input type="hidden" name="_csrf" value={ m.Page.CSRFToken }/>
			<input type="hidden" name="_return" value={ m.Page.ReturnTo }/>
			<fieldset class="choice-set">
				<legend><h2>Style</h2></legend>
				<p class="field-hint">Applies to every page you load. Each is a complete palette and shape system, not a colour swap.</p>
				<div class="choice-grid">
					for _, c := range m.SkinChoices() {
						@choiceButton("skin", c)
					}
				</div>
			</fieldset>
		</form>
	</section>
	<section class="block settings-block">
		<form method="post" action={ m.Page.ThemeAction() }>
			<input type="hidden" name="_csrf" value={ m.Page.CSRFToken }/>
			<input type="hidden" name="_return" value={ m.Page.ReturnTo }/>
			<fieldset class="choice-set">
				<legend><h2>Theme</h2></legend>
				// Three buttons, not a toggle: "follow the system" has to
				// stay reachable after the user has expressed a preference,
				// and a two-state control cannot express it.
				<p class="field-hint">Three states rather than a switch, because once you have chosen one, following the device has to stay reachable.</p>
				<div class="choice-grid">
					for _, c := range m.ThemeChoices() {
						@choiceButton("theme", c)
					}
				</div>
			</fieldset>
		</form>
	</section>
	<section class="block settings-block">
		<h2>Accessibility mode</h2>
		<p class="field-hint">
			The switch is at the foot of the sidebar on every page, so it is never more
			than one click away from whatever you were reading. It is currently
			<strong>{ m.Page.A11yStateLabel() }</strong>.
		</p>
		<p class="field-hint">
			It is never a degraded mode. Every feature, column and action stays exactly
			where it was, and only the rendering changes. Over whichever style and theme
			are active it:
		</p>
		<ul class="effect-list">
			for _, effect := range m.AccessibilityEffects() {
				<li>{ effect }</li>
			}
		</ul>
		<form method="post" action={ m.Page.A11yAction() }>
			<input type="hidden" name="_csrf" value={ m.Page.CSRFToken }/>
			<input type="hidden" name="_return" value={ m.Page.ReturnTo }/>
			<div class="form-actions">
				<button class="btn" type="submit" name="a11y" value={ m.Page.A11yNext() } aria-pressed={ m.Page.A11yPressed() }>
					if m.Page.A11y {
						Turn accessibility mode off
					} else {
						Turn accessibility mode on
					}
				</button>
			</div>
		</form>
	</section>
}

// choiceButton is one option in an appearance control.
//
// A submit button rather than a radio plus a save control: there is nothing
// else on the form to save, so a second step would be a step that exists only
// to be clicked. aria-pressed is what makes it read as a setting rather than
// as an action, and the state also appears as a word, because a selection
// signalled only by fill is signalled by colour alone.
templ choiceButton(name string, c view.SkinChoice) {
	<button class="choice" type="submit" name={ name } value={ c.Value } aria-pressed={ c.Pressed }>
		<span class="choice-label">
			{ c.Label }
			if c.Selected {
				<span class="choice-state">Selected</span>
			}
		</span>
		<span class="choice-summary">{ c.Summary }</span>
	</button>
}

// passwordSection is the one place a person changes their own password.
templ passwordSection(m view.AccountModel) {
	<form class="block settings-block" method="post" action={ templ.SafeURL(m.PasswordAction()) }>
		<input type="hidden" name="_csrf" value={ m.Page.CSRFToken }/>
		<h2>Change password</h2>
		<p class="field-hint" id="change-hint">
			Changing your password signs out every other session you have open. This
			one stays signed in.
		</p>
		<div class="field">
			<label for="current_password">Current password</label>
			<input type="password" id="current_password" name="current_password" autocomplete="current-password" required/>
		</div>
		<div class="field">
			<label for="new_password">New password</label>
			<input type="password" id="new_password" name="new_password" autocomplete="new-password" required/>
		</div>
		<div class="field">
			<label for="confirm_password">Repeat new password</label>
			<input type="password" id="confirm_password" name="confirm_password" autocomplete="new-password" aria-describedby="change-hint" required/>
		</div>
		<div class="form-actions">
			<button class="btn btn-primary" type="submit">Change password</button>
		</div>
	</form>
}

// SystemSettings is the deployment's own configuration.
//
// A fixed route with no record id, like the account page, because settings are
// a singleton: there is one deployment and it has one configuration. Unlike
// the account page the authorization is a scope rather than the structural
// "the session is the subject", because this surface is about everyone.
templ SystemSettings(m view.SystemSettingsModel) {
	@Layout(m.Page) {
		@pageChrome(m.Chrome())
		// One statement for the whole area rather than one per group. The
		// reason is the same everywhere, and repeating it six times would
		// train a reader to stop reading it.
		@zeroState(m.Declared())
		@settingsTile(m.CurrentTile())
	}
}
