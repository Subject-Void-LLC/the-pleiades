package render

import "github.com/Subject-Void-LLC/the-pleiades/internal/ui/view"

// field renders one form control from its declaration.
//
// This is the only switch on FieldKind in the application. Every control
// gets its label, its hint, its error and its aria wiring from the same
// path, so an accessible control is not something a resource author can
// forget to write -- there is nowhere for them to write it.
templ field(m view.FormModel, f view.Field) {
	<div class="field">
		<label for={ m.ControlID(f) }>
			{ f.Label }
			if f.Required {
				// The word, not an asterisk and not a colour: "required"
				// signalled only in red is signalled only to people who
				// see red.
				<span class="field-required">(required)</span>
			}
		</label>
		if f.Help != "" {
			<p class="field-hint" id={ m.HintID(f) }>{ f.Help }</p>
		}
		if len(m.FieldErrorsFor(f)) > 0 {
			<p class="field-hint" id={ m.ErrorID(f) }>
				for _, msg := range m.FieldErrorsFor(f) {
					{ msg }
				}
			</p>
		}
		switch f.Kind {
			case view.KindLongText:
				// maxlength here as well as on the single-line control. A
				// survey file question is the first long-text field that
				// declares a bound, and without this the only sign of it is
				// a 422 after the paste. It stays advice to a cooperating
				// browser, and a loose one: a browser counts UTF-16 code
				// units where the server counts bytes, so multi-byte text
				// is still refused server-side at a length the browser
				// allowed. view.Validate is the check that holds.
				<textarea
					id={ m.ControlID(f) }
					name={ f.Name }
					rows="4"
					aria-invalid={ m.Invalid(f) }
					aria-describedby={ m.DescribedBy(f) }
					if m.MaxLen(f) != "" {
						maxlength={ m.MaxLen(f) }
					}
					if f.Required {
						required
					}
				>{ m.Value(f) }</textarea>
			case view.KindSelect:
				<select
					id={ m.ControlID(f) }
					name={ f.Name }
					aria-invalid={ m.Invalid(f) }
					aria-describedby={ m.DescribedBy(f) }
					if f.Required {
						required
					}
				>
					for _, opt := range m.Choices(f) {
						if opt.Value == m.Value(f) {
							<option value={ opt.Value } selected>{ opt.Label }</option>
						} else {
							<option value={ opt.Value }>{ opt.Label }</option>
						}
					}
				</select>
			case view.KindLookup:
				// One control carrying the field's id, so the <label for>
				// above wires up exactly as it does for every other kind.
				// A group of checkboxes would read better but would leave
				// that label pointing at nothing, and the fix for that is
				// a fieldset and legend, which is a second labelling path
				// through this template for one field to use.
				//
				// size is set so the listbox opens showing several
				// choices: a multi-select rendered one row high looks like
				// an ordinary select and gives no sign that more than one
				// value can be chosen.
				<select
					id={ m.ControlID(f) }
					name={ f.Name }
					multiple
					size="8"
					aria-invalid={ m.Invalid(f) }
					aria-describedby={ m.DescribedBy(f) }
					if f.Required {
						required
					}
				>
					for _, opt := range m.Choices(f) {
						if m.IsSelected(f, opt.Value) {
							<option value={ opt.Value } selected>{ opt.Label }</option>
						} else {
							<option value={ opt.Value }>{ opt.Label }</option>
						}
					}
				</select>
			case view.KindBool:
				<input
					type="checkbox"
					id={ m.ControlID(f) }
					name={ f.Name }
					value="true"
					aria-describedby={ m.DescribedBy(f) }
					if m.Value(f) == "true" {
						checked
					}
				/>
			case view.KindPassword:
				// type="password" and autocomplete="new-password"
				// together, deliberately. The first keeps the value off
				// the screen of somebody launching a job in a room with
				// other people in it; the second stops a browser offering
				// to remember a secret that belongs to one run rather than
				// to this site. A survey password is answered once per
				// launch and never read back, so there is nothing for a
				// password manager to be right about.
				<input
					type="password"
					id={ m.ControlID(f) }
					name={ f.Name }
					value={ m.Value(f) }
					autocomplete="new-password"
					aria-invalid={ m.Invalid(f) }
					aria-describedby={ m.DescribedBy(f) }
					if m.MaxLen(f) != "" {
						maxlength={ m.MaxLen(f) }
					}
					if f.Required {
						required
					}
				/>
			case view.KindNumber:
				<input
					type="number"
					id={ m.ControlID(f) }
					name={ f.Name }
					value={ m.Value(f) }
					aria-invalid={ m.Invalid(f) }
					aria-describedby={ m.DescribedBy(f) }
					if f.Required {
						required
					}
				/>
			default:
				<input
					type="text"
					id={ m.ControlID(f) }
					name={ f.Name }
					value={ m.Value(f) }
					aria-invalid={ m.Invalid(f) }
					aria-describedby={ m.DescribedBy(f) }
					if f.Autocomplete != "" {
						autocomplete={ f.Autocomplete }
					}
					if m.MaxLen(f) != "" {
						maxlength={ m.MaxLen(f) }
					}
					if f.Required {
						required
					}
				/>
		}
	</div>
}
