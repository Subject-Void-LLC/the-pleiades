# Copy to tests/cml/.env (gitignored) and chmod 600 it, to prove
# pleiades import-cml against Cisco's DevNet CML sandbox. It holds
# passwords, so tests/cml/vpn.sh refuses it when anyone but you can read it.
#
# Reserve the "Cisco Modeling Labs" sandbox at developer.cisco.com; the
# reservation email carries the VPN host, port, username and password, and
# the sandbox's own page the CML controller's address and login. The VPN is
# Cisco AnyConnect; tests/cml/vpn.sh connects it with openconnect
# (sudo apt-get install -y openconnect, once).
#
#   tests/cml/vpn.sh up      # asks for your sudo password, then connects
#   tests/cml/vpn.sh status  # the tunnel, and whether the controller answers
#   tests/cml/vpn.sh down
#
# The VPN, from the reservation email. HOST may carry a port (host:port).
PLEIADES_CML_VPN_HOST=devnetsandbox-usw1-reservation.cisco.com:20000
PLEIADES_CML_VPN_USER=
PLEIADES_CML_VPN_PASSWORD=
# The CML controller, reached through the VPN, and its login.
PLEIADES_CML_URL=https://10.10.20.161
PLEIADES_CML_USERNAME=
PLEIADES_CML_PASSWORD=
