    "/jobs": {
      "get": {
        "description": "Returns a bounded page of jobs, newest first, ordered on the job id. Job ids are UUIDv7, so that ordering is chronological and the id doubles as a keyset cursor with no second index and no tiebreaker. Per-device task outcomes are not included; read GET /jobs/{id} for those. Tallies read 0 until a job's state reaches \"completed\".",
        "operationId": "list_jobs",
        "parameters": [
          {
            "description": "Keyset cursor from a previous page's next_cursor. A job id, so a UUID.",
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Maximum jobs to return. Defaults to 50, capped at 200.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "_links": {
                      "description": "Hypermedia affordances available on this resource for the calling identity.",
                      "items": {
                        "properties": {
                          "href": {
                            "type": "string"
                          },
                          "method": {
                            "type": "string"
                          },
                          "rel": {
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "jobs": {
                      "items": {
                        "properties": {
                          "actor": {
                            "description": "The identity subject that requested the job.",
                            "type": "string"
                          },
                          "created_at": {
                            "description": "RFC 3339 timestamp.",
                            "type": "string"
                          },
                          "dispatched": {
                            "type": "integer"
                          },
                          "failed": {
                            "type": "integer"
                          },
                          "group_name": {
                            "type": "string"
                          },
                          "job_id": {
                            "type": "string"
                          },
                          "runbook_id": {
                            "type": "string"
                          },
                          "skipped": {
                            "type": "integer"
                          },
                          "state": {
                            "description": "One of \"pending\", \"fanning_out\", \"completed\", or \"failed\".",
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "next_cursor": {
                      "description": "Opaque keyset cursor. Pass it back as ?after= to fetch the next page. Empty when this is the last page.",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "A page of jobs."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "limit is not a positive integer, or after is not a UUID."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The job store could not be read."
          }
        },
        "security": [
          {
            "bearerAuth": [
              "job:read"
            ]
          }
        ],
        "summary": "List dispatch jobs",
        "x-link-relation": "collection"
      }
    },
    "/jobs/dispatch": {
      "post": {
        "description": "Validates the request, resolves the runbook, persists a pending Job, and publishes one job.requested event. Responds immediately; the actual per-device fan-out happens later, off this request entirely. Poll GET /jobs/{id} for progress and final per-device tallies.",
        "operationId": "dispatch_runbook",
        "parameters": [
          {
            "description": "Inventory group name to target.",
            "in": "query",
            "name": "group",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Runbook ID to dispatch.",
            "in": "query",
            "name": "runbook",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "_links": {
                      "description": "Hypermedia affordances available on this resource for the calling identity.",
                      "items": {
                        "properties": {
                          "href": {
                            "type": "string"
                          },
                          "method": {
                            "type": "string"
                          },
                          "rel": {
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "job_id": {
                      "description": "The server-generated job ID. Poll GET /jobs/{job_id} with it.",
                      "type": "string"
                    },
                    "status": {
                      "description": "Always \"accepted\".",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The job was persisted and will fan out asynchronously."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Missing 'group' or 'runbook' query parameter."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "No identity on the request context."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "No runbook with that ID exists."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The job could not be persisted or published."
          }
        },
        "security": [
          {
            "bearerAuth": [
              "runbook:execute"
            ]
          }
        ],
        "summary": "Dispatch a runbook asynchronously",
        "x-link-relation": "execute"
      }
    },
    "/jobs/{id}": {
      "get": {
        "description": "Reads a dispatch.Job together with every JobTask recorded against it so far. Dispatched/skipped/failed tallies read 0 until state reaches \"completed\"; the tasks array is where a caller reads live per-device progress before then.",
        "operationId": "get_job",
        "parameters": [
          {
            "description": "The job ID, a UUID.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "_links": {
                      "description": "Hypermedia affordances available on this resource for the calling identity.",
                      "items": {
                        "properties": {
                          "href": {
                            "type": "string"
                          },
                          "method": {
                            "type": "string"
                          },
                          "rel": {
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "dispatched": {
                      "description": "Reads 0 until state reaches \"completed\", regardless of live fan-out progress.",
                      "type": "integer"
                    },
                    "failed": {
                      "type": "integer"
                    },
                    "group_name": {
                      "type": "string"
                    },
                    "job_id": {
                      "format": "uuid",
                      "type": "string"
                    },
                    "runbook_id": {
                      "type": "string"
                    },
                    "skipped": {
                      "type": "integer"
                    },
                    "state": {
                      "type": "string"
                    },
                    "tasks": {
                      "items": {
                        "properties": {
                          "device_id": {
                            "type": "string"
                          },
                          "device_name": {
                            "type": "string"
                          },
                          "outcome": {
                            "type": "string"
                          },
                          "reason": {
                            "description": "Present only for a skipped or failed outcome.",
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The job's current state."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "id is not a UUID."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
