                          },
                          "rel": {
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "capabilities": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "executable": {
                      "type": "boolean"
                    },
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "state": {
                      "description": "One of the eight lifecycle states; see docs/10-running-in-production.md.",
                      "type": "string"
                    },
                    "tags": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "version": {
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The created device."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The body is malformed, or name or type is missing or unusable."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
