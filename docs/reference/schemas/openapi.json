{
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "description": "See docs/10-running-in-production.md for token issuance. A route with no matching scope in the token, and no admin role, is refused with 403.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Every route declared in internal/apispec, the package cmd/controller/main.go also builds its real router from, served under /api/v1. A listed route's method, pattern, scope, and link relation are the ones the server enforces. That a listed route is registered at all is not checked by anything, so confirm a route against a running controller before building on it.",
    "title": "Pleiades control plane API",
    "version": "unreleased"
  },
  "openapi": "3.1.0",
  "paths": {
    "/inventory/devices": {
      "get": {
        "description": "Streams a bounded page of devices in DeviceID order. Paging is keyset rather than offset: an offset over a table being written to skips and repeats rows, which on an inventory list means a device silently missing from a page while another is shown twice. Pass the previous page's next_cursor as ?after= to continue.",
        "operationId": "list_devices",
        "parameters": [
          {
            "description": "Restrict to devices in this inventory group.",
            "in": "query",
            "name": "group",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Keyset cursor from a previous page's next_cursor.",
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Maximum devices to return. Defaults to 50, capped at 200.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "_links": {
                      "description": "Hypermedia affordances available on this resource for the calling identity.",
                      "items": {
                        "properties": {
                          "href": {
                            "type": "string"
                          },
                          "method": {
                            "type": "string"
                          },
                          "rel": {
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "devices": {
                      "items": {
                        "properties": {
                          "_links": {
                            "description": "Hypermedia affordances available on this resource for the calling identity.",
                            "items": {
                              "properties": {
                                "href": {
                                  "type": "string"
                                },
                                "method": {
                                  "type": "string"
                                },
                                "rel": {
                                  "type": "string"
                                }
                              },
                              "type": "object"
                            },
                            "type": "array"
                          },
                          "capabilities": {
                            "items": {
                              "type": "string"
                            },
                            "type": "array"
                          },
                          "executable": {
                            "type": "boolean"
                          },
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "state": {
                            "description": "One of the eight lifecycle states; see docs/10-running-in-production.md.",
                            "type": "string"
                          },
                          "tags": {
                            "items": {
                              "type": "string"
                            },
                            "type": "array"
                          },
                          "version": {
                            "type": "integer"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "next_cursor": {
                      "description": "Opaque keyset cursor. Pass it back as ?after= to fetch the next page. Empty when this is the last page.",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "A page of devices."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "limit is not a positive integer, or a parameter contains a control character."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The inventory could not be read."
          }
        },
        "security": [
          {
            "bearerAuth": [
              "inventory:read"
            ]
          }
        ],
        "summary": "List inventory devices",
        "x-link-relation": "collection"
      },
      "post": {
        "description": "Onboards a device the platform did not discover through a sync plugin. Never an upsert: a name already in the inventory is a conflict rather than a silent overwrite, so a caller can always tell a first-time onboard from a re-sync.",
        "operationId": "create_device",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "_links": {
                      "description": "Hypermedia affordances available on this resource for the calling identity.",
                      "items": {
                        "properties": {
                          "href": {
                            "type": "string"
