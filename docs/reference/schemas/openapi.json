                  "type": "object"
                }
              }
            },
            "description": "type names no registered device type."
          }
        },
        "security": [
          {
            "bearerAuth": [
              "inventory:write"
            ]
          }
        ],
        "summary": "Create an inventory device",
        "x-link-relation": "create"
      }
    },
    "/inventory/devices/{name}": {
