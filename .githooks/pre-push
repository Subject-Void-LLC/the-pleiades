#!/bin/sh
#
# pre-push: check that this exact commit has already passed the local gate.
#
# It does NOT run the gate. That is the whole point, and the reason is
# mechanical rather than a preference. Git opens its connection to the
# remote BEFORE running this hook, because it needs the remote's ref
# advertisement to build the lines it feeds us on stdin. A hook that then
# runs a twenty minute suite hands git back a connection that died long
# ago, and the push fails with SIGPIPE, exit 141, and no output at all
# while the gate prints "all checks passed". That was reproduced five
# times on this repository before the cause was found.
#
# So the gate is a process a developer runs on its own schedule:
#
#     make push-gate     # or make ci, which is stricter
#     git push
#
# `make push-gate` and `make ci` each write a receipt naming the commit
# they verified. This hook reads it back. A receipt is only issued from a
# clean tree, which makes this arrangement STRICTER than running the suite
# here used to be: that proved something about the working tree and then
# pushed commits, and with uncommitted edits those are different code.
#
# Skip a single push with `git push --no-verify`.

set -eu

# Git feeds pre-push one line per ref being pushed, on stdin:
#
#     <local ref> <local sha> <remote ref> <remote sha>
#
# An all-zero local sha means that ref is being deleted. A push that only
# deletes refs adds no code for CI to check, so running the full suite for
# it would be pure delay; anything else gets the real run.
only_deletes=yes
shas=""
while read -r _local_ref local_sha _remote_ref _remote_sha; do
	case "$local_sha" in
	*[!0]*)
		only_deletes=no
		shas="$shas $local_sha"
		;;
	esac
done

if [ "$only_deletes" = yes ]; then
	exit 0
fi

# Ask about each commit actually being sent, rather than about HEAD: a
# push can send a ref that is not checked out, and the receipt has to
# describe the thing travelling.
for sha in $shas; do
	if ! go run ./tools/gatereceipt verify --commit "$sha"; then
		exit 1
	fi
done
