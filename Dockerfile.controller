FROM golang:1.26-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# Built as a PACKAGE path, not a single file. A single-file build
# silently stops compiling the moment the composition root is split
# across more than one file, while `make ci` (go build ./...) stays
# green, so the image breaks and nothing else does.
RUN go build -o controller ./cmd/controller

FROM alpine:3.24.1
WORKDIR /app
COPY --from=builder /app/controller .
# RUNBOOK_DIR is resolved at startup and the controller exits if the
# directory is missing, so the image has to contain one. A deployment
# mounts its real runbooks over this path.
RUN mkdir -p /app/runbooks
EXPOSE 8080
CMD ["./controller"]
